@using Restaurant.Shared.Models
@using Restaurant.Shared.Models.Dtos

<div class="card order-card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong>@Order.OrderNumber</strong>
            <span class="text-muted ms-2">Table @Order.TableNumber</span>
        </div>
        <OrderStatusBadge Status="@Order.Status" />
    </div>
    <div class="card-body">
        <p><strong>Customer:</strong> @Order.CustomerName</p>
        <p><strong>Time:</strong> @Order.CreatedAt.ToLocalTime().ToString("g")</p>

        <h6 class="mt-3">Items:</h6>
        <ul class="list-unstyled">
            @foreach (var item in Order.Items)
            {
                <li class="mb-1">
                    @item.Quantity x @item.MenuItemName - $@item.Subtotal.ToString("F2")
                    @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                    {
                        <br /><small class="text-muted">Note: @item.SpecialInstructions</small>
                    }
                </li>
            }
        </ul>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <strong class="h5 mb-0">Total: $@Order.TotalAmount.ToString("F2")</strong>
            @if (ShowActions)
            {
                <div class="btn-group">
                    @if (Order.Status == OrderStatus.Pending)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OnStatusChange(OrderStatus.Confirmed)">Confirm</button>
                    }
                    @if (Order.Status == OrderStatus.Confirmed)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => OnStatusChange(OrderStatus.Preparing)">Prepare</button>
                    }
                    @if (Order.Status == OrderStatus.Preparing)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OnStatusChange(OrderStatus.Ready)">Ready</button>
                    }
                    @if (Order.Status == OrderStatus.Ready)
                    {
                        <button class="btn btn-sm btn-info" @onclick="() => OnStatusChange(OrderStatus.Served)">Served</button>
                    }
                    @if (Order.Status == OrderStatus.Served)
                    {
                        <button class="btn btn-sm btn-secondary" @onclick="() => OnStatusChange(OrderStatus.Completed)">Complete</button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public OrderDto Order { get; set; } = new();

    [Parameter]
    public bool ShowActions { get; set; } = true;

    [Parameter]
    public EventCallback<OrderStatus> OnStatusChanged { get; set; }

    private async Task OnStatusChange(OrderStatus newStatus)
    {
        if (OnStatusChanged.HasDelegate)
        {
            await OnStatusChanged.InvokeAsync(newStatus);
        }
    }
}

<style>
    .order-card {
        border-left: 4px solid #007bff;
    }
</style>