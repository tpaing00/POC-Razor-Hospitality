@using Restaurant.Shared.Models.Dtos

<div class="card menu-item-card">
    <div class="card-body">
        <h5 class="card-title">@MenuItem.Name</h5>
        <p class="card-text">@MenuItem.Description</p>
        <p class="text-muted">@MenuItem.Category</p>
        <div class="d-flex justify-content-between align-items-center">
            <span class="h4 mb-0">$@MenuItem.Price.ToString("F2")</span>
            @if (ShowAddButton && MenuItem.IsAvailable)
            {
                <button class="btn btn-primary" @onclick="OnAddClick">
                    Add to Order
                </button>
            }
            @if (!MenuItem.IsAvailable)
            {
                <span class="badge bg-secondary">Unavailable</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public MenuItemDto MenuItem { get; set; } = new();

    [Parameter]
    public bool ShowAddButton { get; set; } = true;

    [Parameter]
    public EventCallback<MenuItemDto> OnAdd { get; set; }

    private async Task OnAddClick()
    {
        if (OnAdd.HasDelegate)
        {
            await OnAdd.InvokeAsync(MenuItem);
        }
    }
}

<style>
    .menu-item-card {
        margin-bottom: 1rem;
        transition: transform 0.2s;
    }

    .menu-item-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
</style>