@namespace Restaurant.UI.Shared.Components.Upos

@* Handbook Part III · UposSwitch.
   Classes: .u-switch, .is-on.
   Props:   Checked, CheckedChanged, Label (the accessible name), Disabled.
   States:  off — a 50x28 --upos-border track with its 22px white knob at 3px;
            on — --upos-grad-primary with the knob at 25px. The knob slides at
            --upos-dur-fast on --upos-ease, and the fill swaps rather than fading,
            because a gradient is background-image and does not interpolate.
   Notes:   it renders as <button role="switch">, which keeps it reachable from a
            keyboard on the pointer surface that owns it. A disconnect is not a
            bare toggle — one press stops a revenue channel, so a call site pairs
            it with the confirming step §11 describes. Nothing behind it binds
            (GAP-04, GAP-13). *@

<button type="button"
        role="switch"
        aria-checked="@(Checked ? "true" : "false")"
        aria-label="@Label"
        disabled="@Disabled"
        @onclick="Toggle"
        @attributes="Attributes"></button>

@code {
    /// <summary>Whether the switch is on. Supports <c>@bind-Checked</c>.</summary>
    [Parameter] public bool Checked { get; set; }

    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>The accessible name. A switch carries no visible label of its own.</summary>
    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> Attributes => UposAttributes.Merge(
        AdditionalAttributes,
        "u-switch" + (Checked ? " is-on" : string.Empty));

    private async Task Toggle()
    {
        if (Disabled)
        {
            return;
        }

        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
    }
}
