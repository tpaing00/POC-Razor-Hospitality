<html lang="en" data-accent="slate">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Restaurant.UI.Shared/css/upos-tokens.css" />
    <link rel="stylesheet" href="_content/Restaurant.UI.Shared/css/upos-components.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Restaurant.Blazor.styles.css" />
    <link rel="icon" type="image/png" href="icon-192.png" />

    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#20262e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-title" content="Restaurant" />

    <HeadOutlet @rendermode="@InteractiveServer" />
</head>

<body>
    @* prerender:false. The shell puts every route inside one interactive subtree, so a
       page cannot opt out of prerendering on its own — a @rendermode on a page below
       this point is inherited from here and ignored. With prerendering on, a page's
       OnInitializedAsync runs twice in two DI scopes, once on the server render and
       again on the circuit, so the Menu manager pays the HttpClient timeout twice
       before first paint whenever the API is unreachable: roughly ten seconds instead
       of five. The cost of turning it off is that first paint waits for the circuit,
       which is milliseconds on a local server. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    <script src="_framework/blazor.web.js"></script>

    <!-- Theming contract (handbook §11, §12): data-theme and data-accent live on
         <html>, and the shell flips them through interop. Light theme is the
         absence of data-theme. -->
    <script>
        window.uposShell = {
            setTheme: function (theme) {
                if (theme) {
                    document.documentElement.setAttribute('data-theme', theme);
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            },
            setAccent: function (accent) {
                document.documentElement.setAttribute('data-accent', accent);
            }
        };
    </script>
    <!-- Service Worker Registration -->
    <script>
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/service-worker.js')
                    .then(reg => console.log('Service Worker registered', reg))
                    .catch(err => console.log('Service Worker registration failed', err));
            }
    </script>
</body>

</html>
