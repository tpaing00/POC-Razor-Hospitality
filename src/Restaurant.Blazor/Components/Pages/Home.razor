@page "/"
@rendermode InteractiveServer

<PageTitle>Dashboard</PageTitle>

<h1>Welcome to Restaurant Back-office</h1>

<p>Welcome to your new app.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Orders</h5>
                <p class="card-text">Manage and track orders</p>
                <a href="/orders" class="btn btn-primary">View Orders</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Menu</h5>
                <p class="card-text">Manage menu items</p>
                <a href="/menu" class="btn btn-primary">View Menu</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Tables</h5>
                <p class="card-text">Manage table layout</p>
                <a href="#" class="btn btn-secondary disabled">Coming Soon</a>
            </div>
        </div>
    </div>
</div>